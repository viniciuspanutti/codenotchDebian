#!/usr/bin/env python3
"""Explicitly install/remove the small GNOME 48 bridge; never enables autorun."""
import os
from pathlib import Path
import shutil
import subprocess
import sys

uuid = "codenotch-window@codenotch.local"
source = Path(__file__).resolve().parent.parent / "gnome-extension" / uuid
target = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "gnome-shell/extensions" / uuid
command = sys.argv[1] if len(sys.argv) > 1 else "status"
if command == "install":
    target.mkdir(parents=True, exist_ok=True)
    for name in ("metadata.json", "extension.js"):
        shutil.copy2(source / name, target / name)
    result = subprocess.run(["gnome-extensions", "enable", uuid])
    print("Bridge installed. If not loaded, log out/in once, then run: gnome-extensions enable " + uuid)
    sys.exit(result.returncode)
elif command == "remove":
    subprocess.run(["gnome-extensions", "disable", uuid])
    if target.exists():
        shutil.rmtree(target)
elif command == "status":
    sys.exit(subprocess.run(["gnome-extensions", "info", uuid]).returncode)
else:
    sys.exit("Usage: codenotch-gnome-bridge install|status|remove")
